tests/file_eraser_tests.c.i:
	$(MAKE) $(MAKESILENT) -f CMakeFiles/file_eraser_tests.dir/build.make CMakeFiles/file_eraser_tests.dir/tests/file_eraser_tests.c.i
.PHONY : tests/file_eraser_tests.c.i

tests/file_eraser_tests.s: tests/file_eraser_tests.c.s
.PHONY : tests/file_eraser_tests.s

# target to generate assembly for a file
tests/file_eraser_tests.c.s:
	$(MAKE) $(MAKESILENT) -f CMakeFiles/file_eraser_tests.dir/build.make CMakeFiles/file_eraser_tests.dir/tests/file_eraser_tests.c.s
.PHONY : tests/file_eraser_tests.c.s

