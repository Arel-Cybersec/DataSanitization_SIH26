# ──────────────────────────────────────────────
#  DataSanitization / EraseCure — .gitignore
# ──────────────────────────────────────────────

# ── CMake & Build outputs ─────────────────────
build/
**/build/
build-*/
**/build-*/
cmake-build-*/
**/cmake-build-*/
CMakeFiles/
**/CMakeFiles/
CMakeCache.txt
**/CMakeCache.txt
cmake_install.cmake
**/cmake_install.cmake
CTestTestfile.cmake
**/CTestTestfile.cmake
install_manifest.txt
**/install_manifest.txt
compile_commands.json
**/compile_commands.json
.clangd/
.cache/

# ── Compiled binaries & libraries ─────────────
*.o
*.ko
*.obj
*.elf
*.ilk
*.map
*.exp
*.gch
*.pch
*.lib
*.a
*.la
*.lo
*.dll
*.so
*.so.*
*.dylib
*.exe
*.out
*.app
bin/
**/bin/
lib/
**/lib/

# ── Runtime test images (NEVER commit raw disks) ─
*.img
*.image
*.iso
*.vmdk
test_*.img
test.img

# ── Runtime logs, reports & databases ─────────
data/logs/*.jsonl
data/logs/*.log
**/data/logs/*.jsonl
**/data/logs/*.log
data/reports/*
**/data/reports/*
*.db
*.db-shm
*.db-wal
data/erasecure_audit.db

# ── IDE & Editor files ─────────────────────────
.vscode/
.idea/
*.swp
*.swo
*~
.DS_Store
Thumbs.db
desktop.ini

# ── Debug / Profiling ──────────────────────────
*.dSYM/
*.su
*.idb
*.pdb
default.profraw
*.profdata
callgrind.out.*
massif.out.*
